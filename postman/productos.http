@apiUrl = http://localhost:3000/api/productos
@itemId = {{create.response.body.id}}

###

GET {{apiUrl}}

### Probar exito 1

# @name create
POST {{apiUrl}}
content-type: application/json

{
  "marca": "Dell",
  "descripcion": "Computadora todo en uno",
  "precio": 5200,
  "stock": 2
}

### Probar exito 2

# @name create
POST {{apiUrl}}
content-type: application/json

{
  "marca": "AMD",
  "descripcion": "AMD Ryzen 5500",
  "precio": 1980,
  "stock": 2
}

### Probar fallo

POST {{apiUrl}}
content-type: application/json

{
  "marca": "",
  "descripcion": "Computadora todo en uno",
  "precio": 5200,
  "stock": -2
}

###

GET {{apiUrl}}/{{itemId}}

###

PUT {{apiUrl}}/{{itemId}}
content-type: application/json

{
  "marca": "Dell",
  "descripcion": "Servidor profesional",
  "precio": 12000,
  "stock": 2
}

###

DELETE {{apiUrl}}/{{itemId}}
